* { font-family: "Segoe UI"; font-size: 13px; color: #E6EDF3; }
QMainWindow, QWidget { background: #0B0F14; }
QFrame#sidebar, QFrame#topbar { background: #111820; border: 0; }
QFrame#topbar { border-bottom: 1px solid #263442; }
QPushButton { background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 9px 12px; text-align: left; }
QPushButton:hover { background: #1A2733; border-color: #2C465A; }
QPushButton:checked { background: #123448; color: #69D2F5; border-color: #2484A7; }
QPushButton:disabled { color: #59636D; }
QFrame#metricCard { background: #111820; border: 1px solid #263442; border-radius: 6px; min-height: 72px; }
QLabel#metricLabel, QLabel#pageSubtitle { color: #8B949E; font-size: 11px; }
QLabel#metricValue { color: #E6EDF3; font-size: 21px; font-weight: 600; }
QLabel#pageTitle { font-size: 22px; font-weight: 600; }
QLineEdit, QComboBox { background: #161F29; border: 1px solid #263442; border-radius: 4px; padding: 7px; min-height: 18px; }
QTableView { background: #111820; alternate-background-color: #161F29; border: 1px solid #263442; gridline-color: #263442; selection-background-color: #123448; }
QHeaderView::section { background: #161F29; color: #8B949E; border: 0; border-bottom: 1px solid #263442; padding: 8px; }