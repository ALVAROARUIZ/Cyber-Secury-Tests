{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Wallabee": {
    "MaximumFileSize": 104857600,
    "MaximumParallelScans": 4,
    "ScanBufferSize": 81920,
    "LabRoot": "../../lab",
    "Version": "0.1.0"
  },
  "Scanner": {
    "AllowDirectoryScanning": true
  },
  "Quarantine": {
    "Directory": "../../lab/quarantine",
    "AllowRestore": false
  },
  "Benchmark": {
    "Enabled": true,
    "RecordSystemMetrics": false
  },
  "AllowedHosts": "*"
}
