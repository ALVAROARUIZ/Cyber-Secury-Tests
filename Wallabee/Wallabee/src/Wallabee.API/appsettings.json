{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Wallabee": {
    "MaximumFileSize": 104857600,
    "MaximumParallelScans": 4,
    "ScanBufferSize": 81920,
    "LabRoot": "../../lab",
    "Version": "0.1.0"
  },
  "Scanner": {
    "AllowDirectoryScanning": true
  },
  "Quarantine": {
    "Directory": "../../data/quarantine",
    "AllowRestore": false,
    "AutoQuarantine": false
  },
  "Benchmark": {
    "Enabled": true,
    "RecordSystemMetrics": true
  },
  "AllowedHosts": "*",
  "Persistence": {
    "TestHostAlias": "local-lab"
  },
  "Telemetry": {
    "Enabled": false,
    "BaseUrl": "https://localhost:7000",
    "BatchSize": 100,
    "RetryEnabled": true,
    "MaxAttempts": 8,
    "PollSeconds": 2,
    "TimeoutSeconds": 15
  },
  "Scoring": {
    "Low": 20,
    "Medium": 50,
    "High": 75,
    "Critical": 90
  },
  "Heuristics": {
    "KnownHashes": [],
    "HighEntropyThreshold": 7.8,
    "UnusualSizeBytes": 52428800
  },
  "ConnectionStrings": {
    "DiveViewDatabase": "Server=.\\SQLEXPRESS;Database=DiveViewLab;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
